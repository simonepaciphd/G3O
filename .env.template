# Copy this file to `.env` and fill in your credentials. Never commit `.env`.

# Required for live discovery (Google Search via Serper.dev).
# Without this key the discovery layer returns mock results.
SERPER_API_KEY=

# Required for the LLM stages (2 official-site, 3 triage, 5 extract, 6 validate).
# Not needed for discovery (Stage 1) or scrape (Stage 4).
OPENAI_API_KEY=
# Optional. Overrides the pipeline-wide default model for every LLM stage
# (default: gpt-5-nano). The --model CLI flag overrides this per invocation.
OPENAI_MODEL=gpt-5-nano

# Optional. Override the Serper endpoint.
SERPER_ENDPOINT=https://google.serper.dev/search

# Optional. HTTP request timeout in seconds.
REQUEST_TIMEOUT=30

# Optional. User-Agent header used by the scraper.
USER_AGENT=G3O-Observatory/0.1 (https://github.com/simonepaciphd/G3O; spaci@stanford.edu)

# Optional. Where to write per-run artifacts (gitignored by default).
# G3O_CACHE_DIR=./cache
# G3O_RUNS_DIR=./runs

# Optional. Logging level.
LOG_LEVEL=INFO

# Optional. Bright Data Web Unlocker configuration (Phase 3, 2026-09-17).
# The unlocker is a per-URL escalation for refused/blocked fetches (403/406/401/451).
# It renders JS and solves captchas internally at ~$0.002–0.006/page, cheaper than
# the residential proxy render fallback (~$0.046/page). Disabled by default; enable
# via PresweepConfig.scrape_unlocker_on_block or scrape_unlocker_on_empty.
# G3O_UNLOCKER_API_TOKEN is a secret (Bearer token) and must never be committed.
# G3O_UNLOCKER_API_TOKEN=
# G3O_UNLOCKER_ZONE=web_unlocker1
# G3O_UNLOCKER_API_URL=https://api.brightdata.com/request
