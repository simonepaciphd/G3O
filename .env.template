# Copy this file to `.env` and fill in your credentials. Never commit `.env`.

# Required for live discovery (Google Search via Serper.dev).
# Without this key the discovery layer returns mock results.
SERPER_API_KEY=

# Required for the LLM stages (2 official-site, 3 triage, 5 extract, 6 validate).
# Not needed for discovery (Stage 1) or scrape (Stage 4).
OPENAI_API_KEY=
# Optional. Overrides the pipeline-wide default model for every LLM stage
# (default: gpt-5-nano). The --model CLI flag overrides this per invocation.
OPENAI_MODEL=gpt-5-nano

# Required with the default config: TypeSafe jev is the default model for
# Stages 2/3 and 6 (classify_official_site, classify_triage, validate), and a
# live run refuses to start without this key. Not needed only if every stage is
# overridden onto OpenAI. See jev-integration-plan.md for the design.
TYPESAFE_API_KEY=
# Optional. Pinned jev model id (default: jev-1.13.0). Pin to a versioned id,
# not the jev-latest alias, so thresholds tuned against a version stay
# reproducible.
TYPESAFE_MODEL=jev-1.13.0

# Optional. Override the Serper endpoint.
SERPER_ENDPOINT=https://google.serper.dev/search
# Optional. USD per Serper credit for the combined spend ceiling (default 0.001).
# Package-dependent: set it to the rate of the credits actually pre-bought.
# G3O_SERPER_USD_PER_CREDIT=0.001

# Optional. HTTP request timeout in seconds.
REQUEST_TIMEOUT=30

# Optional. User-Agent header used by the scraper.
USER_AGENT=G3O-Observatory/0.1 (https://github.com/simonepaciphd/G3O; spaci@stanford.edu)

# Optional. Where to write per-run artifacts (gitignored by default).
# G3O_CACHE_DIR=./cache
# G3O_RUNS_DIR=./runs

# Optional. Logging level.
LOG_LEVEL=INFO

# Optional. Bright Data Web Unlocker configuration (Phase 3, 2026-09-17).
# The unlocker is a per-URL escalation for refused/blocked fetches (403/406/401/451).
# It renders JS and solves captchas internally; billed at $8/GB on successful
# requests (g3o/common/pricing.py, counted in the combined spend ceiling).
# PresweepConfig.scrape_unlocker_on_block / scrape_unlocker_on_empty default to
# True, so the token is what switches it on: without it the unlocker is silently
# skipped. `g3o doctor` and the preflight report say which state a host is in.
# G3O_UNLOCKER_API_TOKEN is a secret (Bearer token) and must never be committed.
# G3O_UNLOCKER_API_TOKEN=
# G3O_UNLOCKER_ZONE=web_unlocker1
# G3O_UNLOCKER_API_URL=https://api.brightdata.com/request
